{
  "name": "yunhui-ai-companion",
  "version": "0.6.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "yunhui.me 手机伴侣：实时请求、缓存用量、远程客户端与会话管理",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare:ios": "npm run build && node scripts/prepare-ios.mjs",
    "add:ios": "npm run prepare:ios",
    "add:android": "cap add android",
    "sync": "npm run build && cap sync",
    "sync:ios": "npm run prepare:ios && cap sync ios",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "7.6.10"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@capacitor/ios": "7.6.10",
    "@capacitor/android": "7.6.10",
    "esbuild": "0.28.2"
  }
}

